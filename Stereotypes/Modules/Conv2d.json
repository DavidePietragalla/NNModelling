{
  "category": "Layer",
  "pythonClassName": "nn.Conv2d",
  "view": {
    "color": "#20b2aa",
    "width": 140,
    "height": 60
  },
  "params": {
    "in_channels": {
      "type": "int",
      "default": "Undefined",
      "position": "top"
    },
    "out_channels": {
      "type": "int",
      "default": "Undefined",
      "position": "bottom"
    },
    "kernel_size": {
      "type": "int | tuple",
      "default": "Undefined"
    },
    "stride": {
      "type": "int | tuple",
      "default": "1"
    },
    "padding": {
      "type": "int | tuple | str",
      "default": "0"
    },
    "dilation": {
      "type": "int | tuple",
      "default": "1"
    },
    "groups": {
      "type": "int",
      "default": "1"
    },
    "bias": {
      "type": "bool",
      "default": "True"
    },
    "padding_mode": {
      "type": "str",
      "default": "zeros"
    },
    "device": {
      "type": "str",
      "default": "None"
    },
    "dtype": {
      "type": "str",
      "default": "None"
    }
  },
  "type_signature": {
    "kind": "module",
    "input": [
      { "kind": "symbolic", "name": "$B" },
      { "kind": "param_ref", "name": "in_channels" },
      { "kind": "symbolic", "name": "#H" },
      { "kind": "symbolic", "name": "#W" }
    ],
    "output": [
      { "kind": "symbolic", "name": "$B" },
      { "kind": "param_ref", "name": "out_channels" },
      { "kind": "computed", "expr": "floor(($H + 2*padding - dilation*(kernel_size - 1) - 1)/stride + 1)" },
      { "kind": "computed", "expr": "floor(($W + 2*padding - dilation*(kernel_size - 1) - 1)/stride + 1)" }
    ],
    "advisories": [{
      "condition": "kernel_size > $H || kernel_size > $W",
      "message": "kernel_size exceeds one or both input spatial dimensions",
      "kind": "perf"
    }]
  }
}
