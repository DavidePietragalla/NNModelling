set shell := ["bash", "-cu"]

backend_dir := justfile_directory()
converted_dir := backend_dir / ".."
valkey_data_dir := converted_dir / "valkey-data"
valkey_port := env_var_or_default("NNM_VALKEY_PORT", "6379")
api_host := env_var_or_default("NNM_BACKEND_HOST", "127.0.0.1")
api_port := env_var_or_default("NNM_BACKEND_PORT", "8000")
valkey_url := "valkey://127.0.0.1:" + valkey_port + "/0"
uv_cache_dir := env_var_or_default("UV_CACHE_DIR", "/tmp/nnmodelling-uv-cache")

default:
    @just --list

# Start Valkey in the foreground with persistent local data.
valkey:
    mkdir -p "{{valkey_data_dir}}"
    valkey-server "{{backend_dir}}/valkey.conf" --dir "{{valkey_data_dir}}" --port "{{valkey_port}}"

# Start the FastAPI backend in the foreground.
backend:
    cd "{{converted_dir}}" && PYTHONPATH=src NNM_VALKEY_URL="{{valkey_url}}" uv run uvicorn backend.app:app --host "{{api_host}}" --port "{{api_port}}"

# Check that the API is reachable.
health:
    curl --fail --show-error "http://{{api_host}}:{{api_port}}/health"

# List dataset classes discovered from the backend Python environment.
datasets:
    curl --fail --show-error "http://{{api_host}}:{{api_port}}/datasets"

# List jobs known by the backend.
jobs:
    curl --fail --show-error "http://{{api_host}}:{{api_port}}/jobs"

# Run the backend test suite.
test:
    cd "{{converted_dir}}" && UV_CACHE_DIR="{{uv_cache_dir}}" PYTHONPATH=src uv run pytest src/tests/test_remote_backend.py -q

# Build and start the persistent Docker deployment.
docker-up:
    docker compose -f "{{backend_dir}}/docker-compose.yml" up --build

# Stop the Docker deployment without deleting its volumes.
docker-down:
    docker compose -f "{{backend_dir}}/docker-compose.yml" down
