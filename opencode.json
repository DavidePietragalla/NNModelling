{
  "$schema": "https://opencode.ai/config.json",
  "agent": {
    "explore": {
      "disable": true
    }
  },
  "mcp": {
    "nnmodelling-mcp": {
      "type": "local",
      "command": [
        "npx",
        "-y",
        "tsx",
        "mcp-server/src/index.ts"
      ]
    },
    "glimpse-mcp": {
      "type": "local",
      "command": [
        "npx",
        "-y",
        "glimpse-mcp"
      ]
    }
  }
}
